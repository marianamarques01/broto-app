# Supabase (obrigatório)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Produção / preview HTTPS: ALLOWED_ORIGINS no Supabase (Edge Functions → Secrets).
# Produção atual: https://www.brotoenem.com.br,https://brotoenem.com.br

# Formulário de feedback do beta (opcional)
VITE_BETA_FEEDBACK_FORM_URL=https://forms.gle/replace-me

# Tour integrado pós-onboarding. Use `false` para desligar.
# VITE_APP_INTEGRATED_TOUR=false

# Observabilidade — Sentry (opcional; ver docs/observability.md)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
#
# Rotina inteligente: FASTAPI_URL é secret das Edge Functions (não Vite).
# Se vazio, routine-generate reutiliza NOTEBOOKLM_SERVICE_URL (mesmo Railway).
# Documentação completa: docs/routine-generate.md
# FASTAPI_URL=https://seu-servico.railway.app
# Source maps no build de produção (secrets de CI/Vercel — não commitar):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
