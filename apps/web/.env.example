# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Produção ou preview em HTTPS: configure Edge Function secret ALLOWED_ORIGINS com a URL exata do site
# (ex.: https://app.seudominio.com). Para dev em localhost sem secret, as functions aceitam só Origin local.

# Formulário de feedback do beta (opcional mas recomendado). Sem isso o app usa link placeholder até você definir.
VITE_BETA_FEEDBACK_FORM_URL=https://forms.gle/replace-me

# Tour integrado pós-onboarding (carrossel na Home). Use `false` para desligar.
# VITE_APP_INTEGRATED_TOUR=false
