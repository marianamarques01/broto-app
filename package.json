{
  "name": "broto",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint apps/*/src packages/*/src supabase/functions",
    "lint:fix": "eslint apps/*/src packages/*/src supabase/functions --fix",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\" \"apps/mobile/{app,hooks,lib,components,contexts,theme}/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" \"supabase/functions/**/*.ts\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx}\" \"apps/mobile/{app,hooks,lib,components,contexts,theme}/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" \"supabase/functions/**/*.ts\"",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "react-refresh": "^0.17.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.1"
  }
}
