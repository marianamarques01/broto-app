{
  "name": "broto",
  "private": true,
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint apps/*/src packages/*/src supabase/functions",
    "lint:fix": "eslint apps/*/src packages/*/src supabase/functions --fix",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" \"supabase/functions/**/*.ts\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" \"supabase/functions/**/*.ts\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:shared": "npm run test --workspace=@broto/shared",
    "test:web": "npm run test --workspace=@broto/web",
    "deploy:functions": "./scripts/deploy-functions.sh",
    "verify:cors": "./scripts/verify-production-cors.sh",
    "test:functions": "deno test --allow-env --allow-read --config supabase/functions/deno.json supabase/functions/_shared/*_test.ts supabase/functions/auth-signup/validate_test.ts",
    "smoke:network": "node scripts/smoke-network-dashboard.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.1"
  }
}
